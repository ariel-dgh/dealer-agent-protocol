{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealer-ai-visibility",
  "main": "dealer-ai-visibility-worker.mjs",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dealer-ai-visibility-site/dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "dealer-agent-pilot",
      "database_id": "b76b6b11-4773-4c61-821c-b8527d0d1dae",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ANSWER_AUDIT_QUEUE",
        "queue": "dealer-ai-visibility-answer-audit"
      }
    ],
    "consumers": [
      {
        "queue": "dealer-ai-visibility-answer-audit",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "dealer-ai-visibility-answer-audit-dlq"
      }
    ]
  },
  "routes": [
    { "pattern": "dealeraivisibility.com", "custom_domain": true },
    { "pattern": "www.dealeraivisibility.com", "custom_domain": true }
  ]
}

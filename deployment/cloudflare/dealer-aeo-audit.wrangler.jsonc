{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealer-aeo-audit",
  "main": "dealer-aeo-audit-worker.mjs",
  "compatibility_date": "2026-09-05",
  "assets": {
    "binding": "ASSETS",
    "directory": "../../dealer-aeo-audit-site/dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "dealer-agent-pilot",
      "database_id": "b76b6b11-4773-4c61-821c-b8527d0d1dae",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "dealeraeoaudit.com", "custom_domain": true },
    { "pattern": "www.dealeraeoaudit.com", "custom_domain": true }
  ]
}
